#!/usr/bin/env bash
# End-to-end proof: doctor + Welcome Browser test + durable artifacts.
# Usage: .agents/skills/verify-kibbles/bin/prove-welcome
# Do not pipe `php artisan test` through tee — Playwright run-server inherits the pipe.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/../../../.." && pwd)"
cd "$ROOT"

RUN_ID="${RUN_ID:-$(date +%Y%m%d-%H%M%S)}"
ART="artifacts/verify-kibbles/${RUN_ID}"
mkdir -p "$ART/screenshots"
BASE="${VERIFY_BASE_URL:-http://localhost:8000}"
DOCTOR="$(cd "$(dirname "$0")" && pwd)/doctor"

{
  echo "=== prove-welcome run_id=${RUN_ID} ==="
  echo "artifacts=$ART"
  echo "base=$BASE"
  echo "cwd=$ROOT"
} | tee "$ART/summary.txt"

set +e
"$DOCTOR" "$BASE" 2>&1 | tee "$ART/doctor.log"
DOCTOR_RC=${PIPESTATUS[0]}
set -e

curl -sS "$BASE/" -o "$ART/welcome.html" || true
curl -sS -o /dev/null -w "%{http_code}" "$BASE/" > "$ART/welcome.http_code" || echo "000" > "$ART/welcome.http_code"

{
  echo "http_code=$(cat "$ART/welcome.http_code")"
  # Inertia may not SSR page copy; assert shell markers instead
  rg -o '"component":"welcome"|<title>Laravel</title>|name":"Laravel"' "$ART/welcome.html" 2>/dev/null | sort -u || true
} | tee "$ART/welcome.copy.txt"

# Drive mapped welcome feature via existing Browser test.
# Redirect to a file (do not pipe through tee): leftover Playwright keeps the pipe open.
set +e
php artisan test --compact tests/Browser/WelcomeTest.php > "$ART/welcome-browser-test.log" 2>&1
TEST_RC=$?
set -e
cat "$ART/welcome-browser-test.log"

if [[ -d tests/Browser/Screenshots ]]; then
  cp -f tests/Browser/Screenshots/*.png "$ART/screenshots/" 2>/dev/null || true
fi

# Extra durable screenshot using the same Pest Browser harness (not a parallel Playwright CLI)
PROOF_DIR="tests/Browser/_verify_tmp"
mkdir -p "$PROOF_DIR"
cat > "$PROOF_DIR/WelcomeProofTest.php" << 'PHP'
<?php

declare(strict_types=1);

it('captures welcome proof screenshot', function (): void {
    $page = visit('/');

    $page->assertSee('Laravel')
        ->assertSee("Let's get started")
        ->screenshot(true, 'welcome-proof');
});
PHP

set +e
php artisan test --compact "$PROOF_DIR/WelcomeProofTest.php" > "$ART/welcome-proof-test.log" 2>&1
PROOF_RC=$?
set -e
cat "$ART/welcome-proof-test.log"
cat "$ART/welcome-proof-test.log" >> "$ART/welcome-browser-test.log"

if [[ -f tests/Browser/Screenshots/welcome-proof.png ]]; then
  cp -f tests/Browser/Screenshots/welcome-proof.png "$ART/screenshots/"
fi

# Cleanup: remove only the temporary proof test dir we created. Do not delete evidence.
rm -rf "$PROOF_DIR"

{
  echo "doctor_rc=$DOCTOR_RC"
  echo "welcome_test_rc=$TEST_RC"
  echo "proof_screenshot_rc=$PROOF_RC"
  echo "artifacts=$ART"
  ls -la "$ART" || true
  ls -la "$ART/screenshots" || true
} | tee -a "$ART/summary.txt"

if [[ "$DOCTOR_RC" -ne 0 || "$TEST_RC" -ne 0 ]]; then
  echo "=== prove-welcome FAILED (evidence kept at $ART) ==="
  exit 1
fi

echo "=== prove-welcome OK ==="
exit 0
