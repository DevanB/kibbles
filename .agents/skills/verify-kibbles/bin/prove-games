#!/usr/bin/env bash
# Durable proof for Games CRUD: Pest Feature + Browser tests.
# Pest boots its own server — composer dev is not required.
# Doctor against VERIFY_BASE_URL (default http://localhost:8000) is recorded;
# a down composer-dev server does not fail this proof.
# Usage: .agents/skills/verify-kibbles/bin/prove-games
# Do not pipe `php artisan test` through tee — Playwright run-server inherits the pipe.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/../../../.." && pwd)"
cd "$ROOT"

RUN_ID="${RUN_ID:-$(date +%Y%m%d-%H%M%S)}"
ART="artifacts/verify-kibbles/${RUN_ID}"
mkdir -p "$ART"
BASE="${VERIFY_BASE_URL:-http://localhost:8000}"
DOCTOR="$(cd "$(dirname "$0")" && pwd)/doctor"

{
  echo "=== prove-games run_id=${RUN_ID} ==="
  echo "artifacts=$ART"
  echo "base=$BASE"
  echo "cwd=$ROOT"
  echo "note=Feature GameControllerTest + JournalEntryControllerTest + Browser GamesTest + JournalEntriesTest; doctor is informational"
} | tee "$ART/games-summary.txt"

set +e
"$DOCTOR" "$BASE" 2>&1 | tee "$ART/games-doctor.log"
DOCTOR_RC=${PIPESTATUS[0]}
set -e

set +e
php artisan test --compact \
  tests/Feature/Controllers/GameControllerTest.php \
  tests/Feature/Controllers/JournalEntryControllerTest.php \
  tests/Browser/GamesTest.php \
  tests/Browser/JournalEntriesTest.php \
  > "$ART/games-tests.log" 2>&1
TEST_RC=$?
set -e
cat "$ART/games-tests.log"

{
  echo "doctor_rc=$DOCTOR_RC"
  echo "doctor_required=0"
  echo "tests_rc=$TEST_RC"
  echo "feature=tests/Feature/Controllers/GameControllerTest.php tests/Feature/Controllers/JournalEntryControllerTest.php"
  echo "browser=tests/Browser/GamesTest.php tests/Browser/JournalEntriesTest.php"
  echo "verified=guest→login, unverified→verification.notice, unique titles, journal store/update/destroy, browser create/update/delete"
  if [[ "$DOCTOR_RC" -ne 0 ]]; then
    echo "doctor_note=composer dev / $BASE was not green; Pest does not need it"
  fi
  ls -la "$ART" || true
} | tee -a "$ART/games-summary.txt"

if [[ "$TEST_RC" -ne 0 ]]; then
  echo "=== prove-games FAILED (evidence kept at $ART) ==="
  exit 1
fi

echo "=== prove-games OK ==="
exit 0
