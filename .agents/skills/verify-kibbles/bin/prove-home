#!/usr/bin/env bash
# Durable proof for / (home redirect): Pest Browser HomeTest.
# Pest boots its own server — composer dev is not required.
# Doctor against VERIFY_BASE_URL (default http://localhost:8000) is recorded;
# a down composer-dev server does not fail this proof.
# Usage: .agents/skills/verify-kibbles/bin/prove-home
# Do not pipe `php artisan test` through tee — Playwright run-server inherits the pipe.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/../../../.." && pwd)"
cd "$ROOT"

RUN_ID="${RUN_ID:-$(date +%Y%m%d-%H%M%S)}"
ART="artifacts/verify-kibbles/${RUN_ID}"
mkdir -p "$ART"
BASE="${VERIFY_BASE_URL:-http://localhost:8000}"
DOCTOR="$(cd "$(dirname "$0")" && pwd)/doctor"

{
  echo "=== prove-home run_id=${RUN_ID} ==="
  echo "artifacts=$ART"
  echo "base=$BASE"
  echo "cwd=$ROOT"
  echo "note=Browser HomeTest (guest / → /login, verified / → /dashboard); doctor is informational"
} | tee "$ART/home-summary.txt"

set +e
"$DOCTOR" "$BASE" 2>&1 | tee "$ART/home-doctor.log"
DOCTOR_RC=${PIPESTATUS[0]}
set -e

set +e
php artisan test --compact tests/Browser/HomeTest.php \
  > "$ART/home-tests.log" 2>&1
TEST_RC=$?
set -e
cat "$ART/home-tests.log"

{
  echo "doctor_rc=$DOCTOR_RC"
  echo "doctor_required=0"
  echo "tests_rc=$TEST_RC"
  echo "browser=tests/Browser/HomeTest.php"
  echo "verified=guest / → /login + Log in; verified / → /dashboard + Dashboard"
  if [[ "$DOCTOR_RC" -ne 0 ]]; then
    echo "doctor_note=composer dev / $BASE was not green; Pest does not need it"
  fi
  ls -la "$ART" || true
} | tee -a "$ART/home-summary.txt"

if [[ "$TEST_RC" -ne 0 ]]; then
  echo "=== prove-home FAILED (evidence kept at $ART) ==="
  exit 1
fi

echo "=== prove-home OK ==="
exit 0
