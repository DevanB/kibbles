#!/usr/bin/env bash
# Durable proof for the Share Sheet API: Pest Feature tests.
# Pest boots its own application — composer dev is not required.
# Doctor against VERIFY_BASE_URL (default http://localhost:8000) is recorded;
# a down composer-dev server does not fail this proof.
# Usage: .agents/skills/verify-kibbles/bin/prove-share-api
# Do not pipe `php artisan test` through tee — Playwright run-server inherits the pipe.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/../../../.." && pwd)"
cd "$ROOT"
# shellcheck source=common.sh
source "$(cd "$(dirname "$0")" && pwd)/common.sh"

RUN_ID="${RUN_ID:-$(date +%Y%m%d-%H%M%S)}"
ART="artifacts/verify-kibbles/${RUN_ID}"
mkdir -p "$ART"
BASE="${VERIFY_BASE_URL:-http://localhost:8000}"
DOCTOR="$(cd "$(dirname "$0")" && pwd)/doctor"

{
  echo "=== prove-share-api run_id=${RUN_ID} ==="
  echo "artifacts=$ART"
  echo "base=$BASE"
  echo "cwd=$ROOT"
  echo "note=Feature StoreLinkController (share token 201/200/422/401); doctor is informational"
} | tee "$ART/share-api-summary.txt"

set +e
"$DOCTOR" "$BASE" 2>&1 | tee "$ART/share-api-doctor.log"
DOCTOR_RC=${PIPESTATUS[0]}
set -e

stash_vite_hot
echo "vite_hot_stash=${VERIFY_HOT_STASH:-absent}" >> "$ART/share-api-summary.txt"
trap restore_vite_hot EXIT

set +e
php artisan test --compact \
  tests/Feature/Controllers/StoreLinkControllerTest.php \
  > "$ART/share-api-tests.log" 2>&1
TEST_RC=$?
set -e
cat "$ART/share-api-tests.log"

{
  echo "doctor_rc=$DOCTOR_RC"
  echo "doctor_required=0"
  echo "tests_rc=$TEST_RC"
  echo "feature=tests/Feature/Controllers/StoreLinkControllerTest.php"
  echo "verified=401 missing/wrong/read/empty token and unresolved owner, 201 new URL, 200 duplicate, 422 bad URL"
  if [[ "$DOCTOR_RC" -ne 0 ]]; then
    echo "doctor_note=composer dev / $BASE was not green; Pest does not need it"
  fi
  ls -la "$ART" || true
} | tee -a "$ART/share-api-summary.txt"

if [[ "$TEST_RC" -ne 0 ]]; then
  echo "=== prove-share-api FAILED (evidence kept at $ART) ==="
  exit 1
fi

echo "=== prove-share-api OK ==="
exit 0
