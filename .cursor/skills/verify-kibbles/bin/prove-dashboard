#!/usr/bin/env bash
# Durable proof for the dashboard: Pest Feature + Browser tests.
# Pest boots its own server — composer dev is not required.
# Doctor against VERIFY_BASE_URL (default http://localhost:8000) is recorded;
# a down composer-dev server does not fail this proof.
# Usage: .cursor/skills/verify-kibbles/bin/prove-dashboard
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/../../../.." && pwd)"
cd "$ROOT"

RUN_ID="${RUN_ID:-$(date +%Y%m%d-%H%M%S)}"
ART="artifacts/verify-kibbles/${RUN_ID}"
mkdir -p "$ART"
BASE="${VERIFY_BASE_URL:-http://localhost:8000}"
DOCTOR="$(cd "$(dirname "$0")" && pwd)/doctor"

{
  echo "=== prove-dashboard run_id=${RUN_ID} ==="
  echo "artifacts=$ART"
  echo "base=$BASE"
  echo "cwd=$ROOT"
  echo "note=Feature DashboardTest + Browser DashboardTest; doctor is informational"
} | tee "$ART/dashboard-summary.txt"

set +e
"$DOCTOR" "$BASE" 2>&1 | tee "$ART/dashboard-doctor.log"
DOCTOR_RC=${PIPESTATUS[0]}
set -e

set +e
php artisan test --compact \
  tests/Feature/Controllers/DashboardTest.php \
  tests/Browser/DashboardTest.php \
  2>&1 | tee "$ART/dashboard-tests.log"
TEST_RC=${PIPESTATUS[0]}
set -e

{
  echo "doctor_rc=$DOCTOR_RC"
  echo "doctor_required=0"
  echo "tests_rc=$TEST_RC"
  echo "feature=tests/Feature/Controllers/DashboardTest.php"
  echo "browser=tests/Browser/DashboardTest.php"
  echo "verified=guest→login, verified Inertia dashboard, unverified→verification.notice, browser assertSee Dashboard + Log out"
  if [[ "$DOCTOR_RC" -ne 0 ]]; then
    echo "doctor_note=composer dev / $BASE was not green; Pest does not need it"
  fi
  ls -la "$ART" || true
} | tee -a "$ART/dashboard-summary.txt"

if [[ "$TEST_RC" -ne 0 ]]; then
  echo "=== prove-dashboard FAILED (evidence kept at $ART) ==="
  exit 1
fi

echo "=== prove-dashboard OK ==="
exit 0
